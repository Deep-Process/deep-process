graph TB
    subgraph "Production Environment - AWS Cloud (Primary)"
        subgraph "VPC - us-east-1"
            subgraph "Public Subnet"
                ALB[Application Load Balancer<br/>TLS Termination]
                NAT[NAT Gateway]
            end

            subgraph "Private Subnet - EKS Cluster"
                subgraph "API Gateway Pods"
                    GW1[api-gateway-1]
                    GW2[api-gateway-2]
                    GW3[api-gateway-3]
                end

                subgraph "Orchestrator Pods"
                    ORCH1[orchestrator-1]
                    ORCH2[orchestrator-2]
                end

                subgraph "Executor Pool (Auto-Scaling 5-100)"
                    EXEC1[executor-1]
                    EXEC2[executor-2]
                    EXEC_N[executor-N]
                end

                subgraph "Process Services"
                    EXPLORE[deep-explore]
                    COMP[deep-compliance]
                    RISK[deep-risk]
                    ARCH[deep-architect]
                    COMMON[common-processes]
                end

                subgraph "Infrastructure Services"
                    IAM[iam-service]
                    ART[artifact-storage]
                    REPO[process-repo]
                    LLM[llm-integration]
                    WEBHOOK[webhook-dispatcher]
                    MCP[mcp-server]
                end

                subgraph "Observability"
                    PROM[Prometheus]
                    GRAF[Grafana]
                    JAEGER[Jaeger]
                end
            end

            subgraph "Data Layer"
                RDS[(RDS PostgreSQL<br/>Multi-AZ<br/>db.r6g.2xlarge)]
                RDS_RR[(Read Replica)]
            end
        end

        subgraph "Managed Services"
            SQS[SQS FIFO Queue<br/>+ DLQ]
            S3[S3 Bucket<br/>Versioned + Lifecycle]
            SECRETS[Secrets Manager]
            EVENTBRIDGE[EventBridge]
            CLOUDWATCH[CloudWatch Logs]
        end
    end

    subgraph "Production Environment - Azure Cloud (Secondary/Hybrid)"
        subgraph "AKS Cluster - East US"
            AKS_COMP[deep-compliance<br/>On-Prem Replica]
            AKS_RISK[deep-risk<br/>On-Prem Replica]
        end

        BLOB[Azure Blob Storage]
        POSTGRES_AZ[(Azure PostgreSQL<br/>Flexible Server)]
        SERVICE_BUS[Azure Service Bus]
    end

    subgraph "Enterprise On-Prem (Optional - HIPAA Customers)"
        subgraph "Customer Data Center"
            K8S_ONPREM[Kubernetes Cluster<br/>Air-Gapped]
            POSTGRES_ONPREM[(PostgreSQL<br/>Customer-Managed)]
            MINIO[MinIO Object Storage]
        end
    end

    subgraph "External Services"
        ANTHROPIC[Anthropic API<br/>Claude]
        OPENAI[OpenAI API<br/>GPT]
        OKTA[Okta SSO]
        AZUREAD[Azure AD]
    end

    subgraph "Users"
        DEV[Enterprise Developers]
        ADMIN[Enterprise Admins]
        COMPLIANCE_USER[Compliance Officers]
    end

    %% User Connections
    DEV -->|HTTPS| ALB
    ADMIN -->|HTTPS| ALB
    COMPLIANCE_USER -->|HTTPS| ALB

    %% ALB Routing
    ALB --> GW1
    ALB --> GW2
    ALB --> GW3

    %% API Gateway to Orchestrator
    GW1 --> ORCH1
    GW2 --> ORCH2

    %% Orchestrator to Queue
    ORCH1 --> SQS
    ORCH2 --> SQS

    %% Queue to Executors
    SQS --> EXEC1
    SQS --> EXEC2
    SQS --> EXEC_N

    %% Executors to Process Services
    EXEC1 --> EXPLORE
    EXEC1 --> COMP
    EXEC1 --> RISK
    EXEC1 --> ARCH
    EXEC1 --> COMMON

    %% Process Services to Infrastructure
    EXPLORE --> LLM
    COMP --> LLM
    RISK --> LLM
    ARCH --> LLM

    EXEC1 --> ART
    EXEC1 --> REPO

    %% LLM Integration to External
    LLM -->|HTTPS| ANTHROPIC
    LLM -->|HTTPS| OPENAI

    %% IAM to SSO
    IAM -->|SAML/OIDC| OKTA
    IAM -->|SAML/OIDC| AZUREAD

    %% Storage Connections
    ART --> S3
    REPO --> S3
    IAM --> RDS
    ORCH1 --> RDS
    ORCH2 --> RDS

    %% Secrets
    IAM --> SECRETS
    LLM --> SECRETS

    %% Observability
    GW1 -.->|metrics| PROM
    ORCH1 -.->|metrics| PROM
    EXEC1 -.->|metrics| PROM
    PROM --> GRAF

    GW1 -.->|logs| CLOUDWATCH
    ORCH1 -.->|logs| CLOUDWATCH

    GW1 -.->|traces| JAEGER
    ORCH1 -.->|traces| JAEGER

    %% Webhooks
    ORCH1 --> EVENTBRIDGE
    EVENTBRIDGE --> WEBHOOK

    %% Hybrid Deployment (Azure)
    COMP -.->|replicate| AKS_COMP
    RISK -.->|replicate| AKS_RISK
    AKS_COMP --> BLOB
    AKS_COMP --> POSTGRES_AZ

    %% On-Prem (Optional)
    K8S_ONPREM -->|Air-Gapped| POSTGRES_ONPREM
    K8S_ONPREM --> MINIO

    style ALB fill:#f9f,stroke:#333,stroke-width:2px
    style SQS fill:#ff9,stroke:#333,stroke-width:2px
    style RDS fill:#9cf,stroke:#333,stroke-width:2px
    style S3 fill:#9cf,stroke:#333,stroke-width:2px
    style ANTHROPIC fill:#f99,stroke:#333,stroke-width:2px
    style K8S_ONPREM fill:#9f9,stroke:#333,stroke-width:2px
