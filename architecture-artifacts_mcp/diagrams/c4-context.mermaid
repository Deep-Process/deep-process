  System(platform, "Deep-* Process Platform", "Orchestrates and executes 13 deep-* verification and governance processes with multi-tenant isolation")

  System_Ext(github, "GitHub / Azure DevOps", "CI/CD pipelines, code repositories")
  System_Ext(ide, "Claude Code / GitHub Copilot", "IDE-integrated AI assistants")
  System_Ext(llm, "Anthropic / OpenAI APIs", "LLM providers for process execution")
  System_Ext(sso, "Okta / Azure AD", "Enterprise SSO providers")
  System_Ext(notify, "Slack / Email", "Notification channels")

  Rel(devs, platform, "Submits jobs, retrieves artifacts", "REST API / MCP")
  Rel(admins, platform, "Manages configuration, views dashboards", "Web UI / API")
  Rel(compliance, platform, "Runs compliance assessments", "Web UI / API")

  Rel(github, platform, "Triggers process execution", "Webhooks / CI/CD plugins")
  Rel(ide, platform, "Invokes processes", "MCP protocol")

  Rel(platform, llm, "Sends prompts, receives completions", "REST API")
  Rel(platform, sso, "Authenticates users", "SAML / OIDC")
