{
  "name": "@deep-process/api-server",
  "version": "1.0.0",
  "description": "Cloud API server for Deep Process workflows with multi-tenancy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deep-process-api": "./dist/server.js"
  },
  "files": [
    "dist/",
    "migrations/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "migrate:rollback": "node dist/db/migrate.js rollback",
    "migrate:status": "node dist/db/migrate.js status"
  },
  "keywords": [
    "deep-process",
    "api",
    "rest",
    "graphql",
    "multi-tenant",
    "cloud",
    "workflow",
    "execution"
  ],
  "author": "Deep Process Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/deep-process.git",
    "directory": "packages/api-server"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@deep-process/core": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "bullmq": "^5.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "pino": "^9.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
