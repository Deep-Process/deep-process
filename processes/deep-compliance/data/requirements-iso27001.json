{
  "regulation_id": "iso27001",
  "regulation_name": "ISO/IEC 27001:2022 Information Security Management",
  "version": "1.0",
  "last_updated": "2022-10-25",
  "requirements": [
    {
      "id": "ISO27001-5.1",
      "article": "5",
      "section": "5.1",
      "text": "Top management shall demonstrate leadership and commitment with respect to the information security management system",
      "keywords": ["leadership", "commitment", "top management", "ISMS", "governance"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-6.1.2",
      "article": "6",
      "section": "6.1.2",
      "text": "The organization shall assess information security risks by identifying threats, vulnerabilities, and consequences",
      "keywords": ["risk assessment", "threats", "vulnerabilities", "consequences", "analysis"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-6.1.3",
      "article": "6",
      "section": "6.1.3",
      "text": "The organization shall evaluate information security risks and define risk treatment options",
      "keywords": ["risk evaluation", "risk treatment", "options", "mitigation", "acceptance"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-7.2",
      "article": "7",
      "section": "7.2",
      "text": "The organization shall ensure persons doing work under its control are competent and aware of information security",
      "keywords": ["competence", "awareness", "training", "personnel", "security"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-7.5",
      "article": "7",
      "section": "7.5",
      "text": "The organization shall create and update documented information required by the ISMS",
      "keywords": ["documentation", "documented information", "records", "maintained", "updated"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-8.1",
      "article": "8",
      "section": "8.1",
      "text": "The organization shall plan, implement and control processes needed to meet information security requirements",
      "keywords": ["operational planning", "processes", "implementation", "control", "requirements"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-9.1",
      "article": "9",
      "section": "9.1",
      "text": "The organization shall monitor, measure, analyze and evaluate the information security performance",
      "keywords": ["monitoring", "measurement", "analysis", "evaluation", "performance"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-9.2",
      "article": "9",
      "section": "9.2",
      "text": "The organization shall conduct internal audits at planned intervals to determine whether the ISMS conforms to requirements",
      "keywords": ["internal audit", "audits", "conformity", "planned", "intervals"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.5.1",
      "article": "Annex A",
      "section": "5.1",
      "text": "Policies for information security and topic-specific policies shall be defined, approved, published, communicated and acknowledged",
      "keywords": ["policies", "information security policy", "approved", "published", "communicated"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.5.7",
      "article": "Annex A",
      "section": "5.7",
      "text": "Threat intelligence information shall be collected and analyzed to produce threat intelligence",
      "keywords": ["threat intelligence", "collection", "analysis", "security threats", "information"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.8.1",
      "article": "Annex A",
      "section": "8.1",
      "text": "User endpoint devices shall be protected against malware",
      "keywords": ["malware", "protection", "endpoint", "antivirus", "devices"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.8.5",
      "article": "Annex A",
      "section": "8.5",
      "text": "Access to source code shall be appropriately managed",
      "keywords": ["source code", "access control", "code management", "authorization", "repository"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.8.10",
      "article": "Annex A",
      "section": "8.10",
      "text": "Information deletion shall ensure that data is made permanently irretrievable when no longer required",
      "keywords": ["deletion", "data destruction", "irretrievable", "sanitization", "disposal"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.8.16",
      "article": "Annex A",
      "section": "8.16",
      "text": "Activities, exceptions, faults and other relevant events shall be logged, monitored, analyzed and reviewed",
      "keywords": ["logging", "monitoring", "audit trail", "events", "review"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "ISO27001-A.8.24",
      "article": "Annex A",
      "section": "8.24",
      "text": "Cryptographic keys shall be managed through a key management system based on agreed standards and procedures",
      "keywords": ["cryptographic", "key management", "encryption", "keys", "procedures"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    }
  ]
}
