{
  "regulation_id": "gdpr",
  "regulation_name": "General Data Protection Regulation",
  "version": "1.0",
  "last_updated": "2018-05-25",
  "requirements": [
    {
      "id": "GDPR-ART5-1A",
      "article": "Article 5",
      "section": "5.1.a",
      "text": "Personal data shall be processed lawfully, fairly and in a transparent manner (lawfulness, fairness and transparency)",
      "keywords": ["lawful", "fair", "transparent", "processing", "personal data"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART5-1B",
      "article": "Article 5",
      "section": "5.1.b",
      "text": "Personal data shall be collected for specified, explicit and legitimate purposes (purpose limitation)",
      "keywords": ["purpose", "specified", "explicit", "legitimate", "collection"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART5-1C",
      "article": "Article 5",
      "section": "5.1.c",
      "text": "Personal data shall be adequate, relevant and limited to what is necessary (data minimisation)",
      "keywords": ["minimisation", "adequate", "relevant", "limited", "necessary"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART5-1D",
      "article": "Article 5",
      "section": "5.1.d",
      "text": "Personal data shall be accurate and, where necessary, kept up to date (accuracy)",
      "keywords": ["accurate", "up-to-date", "correct", "data quality"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART5-1E",
      "article": "Article 5",
      "section": "5.1.e",
      "text": "Personal data shall be kept in a form which permits identification of data subjects for no longer than is necessary (storage limitation)",
      "keywords": ["storage", "retention", "deletion", "limitation", "time"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART5-1F",
      "article": "Article 5",
      "section": "5.1.f",
      "text": "Personal data shall be processed in a manner that ensures appropriate security including protection against unauthorised or unlawful processing (integrity and confidentiality)",
      "keywords": ["security", "confidentiality", "integrity", "protection", "unauthorised"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART6-1",
      "article": "Article 6",
      "section": "6.1",
      "text": "Processing shall be lawful only if at least one legal basis applies (consent, contract, legal obligation, vital interests, public task, or legitimate interests)",
      "keywords": ["legal basis", "consent", "contract", "lawful", "legitimate"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART13-1",
      "article": "Article 13",
      "section": "13.1",
      "text": "Controller shall provide data subject with identity of controller, contact details of DPO, purposes and legal basis of processing, and retention period",
      "keywords": ["information", "transparency", "disclosure", "purposes", "retention"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART15-1",
      "article": "Article 15",
      "section": "15.1",
      "text": "Data subject shall have the right to obtain confirmation whether personal data is being processed and access to such data",
      "keywords": ["access", "right", "confirmation", "data subject", "request"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART17-1",
      "article": "Article 17",
      "section": "17.1",
      "text": "Data subject shall have the right to obtain erasure of personal data without undue delay (right to be forgotten)",
      "keywords": ["erasure", "deletion", "right to be forgotten", "remove"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART25-1",
      "article": "Article 25",
      "section": "25.1",
      "text": "Controller shall implement appropriate technical and organisational measures for data protection by design and by default",
      "keywords": ["privacy by design", "privacy by default", "technical measures", "organisational"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART32-1",
      "article": "Article 32",
      "section": "32.1",
      "text": "Controller and processor shall implement appropriate technical and organisational measures to ensure security of processing",
      "keywords": ["security", "encryption", "pseudonymisation", "resilience", "confidentiality"],
      "annex_iii_categories": [],
      "general_purpose_applicable": true
    },
    {
      "id": "GDPR-ART33-1",
      "article": "Article 33",
      "section": "33.1",
